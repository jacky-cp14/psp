{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@psp/core": ["../packages/psp-list-core/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "./*.tsx",
    "./*.ts",
    "lists/**/*.tsx",
    "__tests__/**/*.tsx",
    "vitest.setup.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
